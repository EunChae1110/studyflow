# PostgreSQL (Drizzle)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/studyflow

# AI mid-station (中轉站) — OpenAI-compatible proxy/relay
# Fill with your relay endpoint + key (do not commit real secrets)
AI_BASE_URL=
AI_API_KEY=
# Aliases also accepted:
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional model id overrides shown in Prompt Bar (must match mid-station ids)
NEXT_PUBLIC_AI_MODEL_GPT=gpt-6.1-sol
NEXT_PUBLIC_AI_MODEL_CLAUDE=claude-opus-5.5

# Session cookie signing (generate a long random string)
AUTH_SECRET=

# Optional polite contact for OpenAlex / Crossref (recommended)
OPENALEX_MAILTO=
CROSSREF_MAILTO=
